# .gitignore for VersionMark (.NET / C# project)

# Build outputs
bin/
obj/
artifacts/

# .NET
*.user
*.suo
*.rsuser
*.userosscache
*.sln.docstates
*.userprefs
mono_crash.*
.vs/
*.slnx.user
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
TestResults/
*.trx
*.xml
coverage.opencover.xml

# Benchmark Results
BenchmarkDotNet.Artifacts/

# .NET artifacts
project.lock.json
project.fragment.lock.json

# Visual Studio Code (keep settings, tasks, launch, extensions)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Python virtual environment
.venv/
__pycache__/
*.py[cod]
*$py.class

# Node
node_modules/
npm-debug.log

# Generated compliance documents (build outputs - never committed)
**/generated/

# Agent logs
.agent-logs/
AGENT_REPORT_*.md

# OS
.DS_Store
Thumbs.db
*.tmp
*.temp
*.log

# VersionMark captures (generated during CI/CD)
versionmark-*.json
/package-lock.json
